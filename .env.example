# ARUGA Server Configuration Template
# Copy this file to .env and fill in your values

# Deployment Environment: development or production
# Note: In production mode, custom ARUGA_API_KEY and SECRET_KEY are strictly required.
ENVIRONMENT=development

# Enable or disable debug override endpoints (/api/debug/override/{patient_id})
ENABLE_DEBUG_ENDPOINTS=false

# Enable or disable public OpenAPI Swagger documentation (/docs, /redoc, /openapi.json)
ENABLE_API_DOCS=false

# Secret API Key required for hardware devices (ESP32) and telemetry endpoints
ARUGA_API_KEY=your_secure_api_key_here

# Session Secret Key for session cookie encryption
SECRET_KEY=your_secret_key_here

# Database Connection URL (SQLite or PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/aruga_db

# Cloudflare R2 Storage Settings
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=aruga-live-feed

# Optional Public CDN Domain (LEAVE BLANK FOR PRIVATE BUCKET WITH SECURE PRESIGNED URLS)
R2_PUBLIC_URL=

# Live Feed Storage Quotas & Cost Protection Limits
MAX_LIVE_FEED_IMAGES_PER_USER=150
LIVE_FEED_MIN_SAVE_INTERVAL_SECONDS=3.0

